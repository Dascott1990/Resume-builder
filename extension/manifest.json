{
  "manifest_version": 3,
  "name": "Noqeev Job Saver",
  "version": "1.1.0",
  "description": "Save job postings from LinkedIn, Indeed, and other job boards straight into your Noqeev Job Tracker.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://resume-builder-blfc.onrender.com/*"
  ]
}
